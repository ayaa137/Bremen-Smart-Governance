flowchart TB
    accTitle: Bremen Smart Governance Part 2 four-layer architecture
    accDescr: Four layers show existing municipal sources, local exchange and analytics, the implemented 2024-v1 integration and offline student dashboard, proposed municipal services and future fieldwork. Each component carries a status label.

    subgraph L1["1 · Data acquisition"]
        direction LR
        A["EXISTING<br/>Official Bremen statistics<br/>Workbook and CSV snapshots"]
        B["EXISTING<br/>Official boundary data<br/>Archived GML and crosswalk"]
        C["EXISTING<br/>Saved analytical outputs<br/>Versioned integration inputs"]
        D["FUTURE<br/>Fieldwork observations<br/>Collect if approved"]
        A ~~~ B ~~~ C ~~~ D
    end

    subgraph L2["2 · Transmission"]
        direction LR
        E["EXISTING<br/>Local file exchange<br/>Repository snapshots"]
        F["PROPOSED<br/>Secure HTTPS or API updates<br/>Verify origin and checksums"]
        E ~~~ F
    end

    subgraph L3["3 · Processing and storage"]
        direction LR
        G["EXISTING<br/>Python validation and analysis<br/>Saved Part 1 and Part 2 results"]
        H["IMPLEMENTED<br/>Read-only integration<br/>Validated 2024-v1 release"]
        I["PROPOSED<br/>Versioned municipal storage<br/>Archive and release catalogue"]
        G ~~~ H ~~~ I
    end

    subgraph L4["4 · Decision support"]
        direction LR
        J["EXISTING<br/>Reports and notebooks<br/>Tables, figures and PDFs"]
        K["IMPLEMENTED<br/>Offline student dashboard<br/>Read-only 2024 evidence"]
        N["PROPOSED<br/>Municipal dashboard<br/>Neighborhood comparison"]
        M["PROPOSED<br/>Human review of options<br/>Pilot and evaluate if approved"]
        J ~~~ K ~~~ N ~~~ M
    end

    L1 --> L2 --> L3 --> L4

    classDef existing fill:#eaf1f8,stroke:#648099,color:#162f49,stroke-width:1.4px
    classDef implemented fill:#dcf5eb,stroke:#168368,color:#103b33,stroke-width:2.3px
    classDef proposed fill:#f3edfa,stroke:#79599b,color:#382653,stroke-width:1.5px,stroke-dasharray:6 3
    classDef future fill:#fff3db,stroke:#987025,color:#513a12,stroke-width:1.5px,stroke-dasharray:2 3
    class A,B,C,E,G,J existing
    class H,K implemented
    class F,I,N,M proposed
    class D future
